# 已部署的 Java 评分后端地址。Docker 访问宿主机可使用 http://host.docker.internal:8081
JAVA_BACKEND_URL=http://host.docker.internal:8081

# OpenAI 兼容大模型
LLM_MODE=openai
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=qwen3.7-plus

# 前端调用 Agent 的 Bearer Key。请改成随机长字符串；JSON 数组格式。
AUTH_ENABLED=true
AUTH_API_KEYS=["replace-with-your-agent-api-key"]

# 暂无数据库账号时使用 SQLite 保存会话，不影响评分接口测试。
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_PATH=/app/data/memory.db

# 智能问数默认关闭；后续取得业务数据库只读账号后再配置。
DATA_QUERY_ENABLED=false
DATA_QUERY_DB_TYPE=mysql
DATA_QUERY_DB_HOST=host.docker.internal
DATA_QUERY_DB_PORT=8084
DATA_QUERY_DB_USER=readonly_user
DATA_QUERY_DB_PASSWORD=
DATA_QUERY_DB_NAME=admin_new
DATA_QUERY_GATEWAY_URL=http://172.17.0.1:8085
